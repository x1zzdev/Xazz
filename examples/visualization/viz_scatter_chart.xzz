// Xazz Visualization Example — Scatter Chart
// 공부시간과 성적의 상관관계를 산점도로 시각화
//
// 사용법: xazz run examples/visualization/viz_scatter_chart.xzz
//
// 외부 CSV 없이 인메모리 DuckDB 리터럴을 소스로 쓴다.
// 이름 같은 직접 식별자(direct identifier)는 내보내지 않는다 — 정책
// DIRECT_IDENTIFIER_EXPOSED 차단을 피하려면 집계/비식별 컬럼만 시각화한다.

type StudentData = {
    study_hours: float,
    score:       float,
}

v by_score = load("duckdb://:memory:?sql=SELECT 2.0 AS study_hours, 55.0 AS score UNION ALL SELECT 4.0, 68.0 UNION ALL SELECT 6.0, 74.5 UNION ALL SELECT 8.0, 88.0 UNION ALL SELECT 10.0, 95.5") :: StudentData
    |> dropNull("study_hours")
    |> dropNull("score")
    |> chart {
        type: scatter
        x: study_hours
        y: score
        title: "공부시간과 성적"
    };
