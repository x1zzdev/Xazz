// Xazz 데모 1 — Polars 전처리 + 차트 시각화
type Air = {
    observed_at:   string,
    district:      string,
    pm25:          Option<float>,
    temperature_c: float,
}
v raw = load("visual-ide/data/seoul_air_quality.csv") :: Air
v cleaned = raw |> fillNull("pm25", strategy: "mean")
v summary = cleaned
    |> groupBy("district")
    |> mean("pm25")
    |> orderBy("pm25", desc: true)
v result_chart = summary
    |> take(5)
    |> chart {
        type: bar
        x: district
        y: pm25
        title: "PM25 mean by district"
    }
