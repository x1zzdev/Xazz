{
  "id": "xazz-healthcare-strict",
  "version": "1.0.0",
  "description": "의료 데이터 파이프라인용 강화 정책 — 의료법·개인정보보호법의 민감정보 처리 기준을 반영한다. 기본 정책보다 준식별자 임계치가 낮고, 경로 탈출까지 차단한다.",
  "direct_identifiers": [
    "patient_id",
    "patient_no",
    "mrn",
    "chart_no",
    "환자번호",
    "차트번호",
    "name",
    "full_name",
    "성명",
    "이름",
    "ssn",
    "rrn",
    "주민등록번호",
    "주민번호",
    "phone",
    "phone_number",
    "mobile",
    "전화번호",
    "연락처",
    "email",
    "이메일",
    "address",
    "home_address",
    "주소",
    "guardian_name",
    "보호자명",
    "guardian_phone",
    "보호자연락처",
    "insurance_no",
    "보험증번호",
    "device_id",
    "ip_address"
  ],
  "sensitive_attributes": [
    "disease",
    "diagnosis",
    "diagnosis_code",
    "진단명",
    "병명",
    "질병",
    "medication",
    "prescription",
    "처방",
    "약물",
    "lab_result",
    "검사결과",
    "blood_type",
    "혈액형",
    "genetic_info",
    "dna",
    "medical_history",
    "병력",
    "mental_health",
    "정신건강",
    "pregnancy",
    "임신",
    "hiv_status",
    "disability",
    "장애",
    "operation_history",
    "수술이력"
  ],
  "quasi_identifiers": [
    "age",
    "나이",
    "연령",
    "birth_date",
    "date_of_birth",
    "dob",
    "생년월일",
    "gender",
    "sex",
    "성별",
    "zip_code",
    "postal_code",
    "우편번호",
    "admission_date",
    "입원일",
    "discharge_date",
    "퇴원일",
    "department",
    "진료과",
    "nationality",
    "국적",
    "occupation",
    "직업"
  ],
  "quasi_identifier_threshold": 2,
  "require_dp_for_sensitive_aggregate": true,
  "max_epsilon": 1.0,
  "remediation_epsilon": 0.5,
  "allowed_output_columns": [
    "age_band",
    "visit_count"
  ],
  "denied_path_fragments": [
    "/etc/passwd",
    "/etc/shadow",
    "/proc/self/environ",
    "/.ssh/",
    "id_rsa",
    ".aws/credentials",
    ".kube/config"
  ],
  "rule_severity": {
    "XZP013": "block",
    "XZP014": "block"
  },
  "domain": "healthcare",
  "risk_level": "high",
  "rule_source_refs": {
    "XZP001": "의료법 제19조(정보 누설 금지) · 개인정보 보호법 제24조(고유식별정보의 처리 제한)",
    "XZP002": "개인정보 보호법 제23조(민감정보의 처리 제한) — 건강에 관한 정보",
    "XZP003": "개인정보 보호법 제28조의5(가명정보 처리 시 금지의무) · 「보건의료 데이터 활용 가이드라인」 재식별 위험 평가",
    "XZP004": "「보건의료 데이터 활용 가이드라인」 — 통계 공개 시 소집단 재식별 방지"
  }
}
