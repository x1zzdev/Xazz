{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xazz",
  "scopeName": "source.xazz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xazz",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xazz",
          "match": "\\b(type|v|mut|model|import|train|predict|chart|withDp|withColumn|join|save|load)\\b"
        },
        {
          "name": "keyword.operator.word.xazz",
          "match": "\\b(filter|select|groupBy|count|sum|mean|min|max|median|std|variance|orderBy|take|sample|dropNull|fillNull|cast|rename|replace|head|tail|unique|sort|agg)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.xazz",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.typeassign.xazz",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.xazz",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.xazz",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.xazz",
          "match": "\\+|-|\\*|/"
        },
        {
          "name": "keyword.operator.assignment.xazz",
          "match": "="
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.xazz",
          "match": "\\b(string|int|float|bool|boolean|Option)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.xazz",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xazz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.xazz",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xazz",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.xazz",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
