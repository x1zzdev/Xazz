// Xazz 보안 가드레일 데모 — 하드코딩된 비밀값 예제 (issue #2)
//
// 자동 보정으로는 해소할 수 없는 위반(residual)을 보여 준다.
// 소스에서 값을 지우는 것만으로는 끝나지 않으며, 노출된 자격증명은
// 즉시 폐기·재발급해야 한다.
//
//   xazz policy examples/security/patient_secret_leak.xzz --fix
//
// ⚠️ 아래 값들은 전부 합성 값이며 실제 자격증명이 아니다.

type Patient = {
    patient_id: string,
    age_band: string,
    disease: string,
};

// XZP010: 주민등록번호 리터럴 (체크섬만 맞춘 합성 번호)
v flagged = load("examples/security/data/patients.csv") :: Patient
    |> filter(patient_id == "900101-1234568")
    |> select([age_band]);

