type AirQuality = {
    date: string,
    station: string,
    pm10: Option<float>,
    pm25: Option<float>,
};

// 1. sample(n) — 시드 없음
v air = load("examples/seoul_air_2026.csv") :: AirQuality
    |> fillNull("pm10", 0.0)
    |> fillNull("pm25", 0.0)
    |> sample(20);

// 2. sample(n, seed) — 재현 가능한 샘플링
v air_seeded = load("examples/seoul_air_2026.csv") :: AirQuality
    |> fillNull("pm10", 0.0)
    |> fillNull("pm25", 0.0)
    |> sample(20, seed: 42);

// 3. median (전체)
v pm10_median = air
    |> median("pm10");

// 4. variance (전체)
v pm10_variance = air
    |> variance("pm10");

// 5. std (전체)
v pm10_std = air
    |> std("pm10");

// 6. groupBy 후 median/variance/std
v station_median = air
    |> groupBy("station")
    |> median("pm25");

v station_variance = air
    |> groupBy("station")
    |> variance("pm25");

v station_std = air
    |> groupBy("station")
    |> std("pm25");
