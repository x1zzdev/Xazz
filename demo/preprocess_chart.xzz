// Xazz 데모 1 — Polars 전처리 + 차트 시각화 (실데이터 10,000행)
//
//   xazz run demo/preprocess_chart.xzz
//
// 서울시 공기질 10,000행에서 구(區)별 PM2.5 평균 상위 5개를 집계해 막대 차트로 그린다.
type Air = {
    observed_at: string,
    district:    string,
    pm10:        Option<float>,
    pm25:        Option<float>,
}
v raw = load("demo/data/seoul_air_sample.csv") :: Air
v cleaned = raw |> fillNull("pm25", strategy: "mean")
v summary = cleaned
    |> groupBy("district")
    |> mean("pm25")
    |> orderBy("pm25", desc: true)
v result_chart = summary
    |> take(5)
    |> chart {
        type: bar
        x: district
        y: pm25
        title: "PM25 mean by district"
    }
