// Xazz 보안 가드레일 데모 — 정책을 통과하는 안전한 예제 (issue #2)
//
// 위 두 예제와 같은 질문("어떤 연령대에 어떤 질병이 많은가")에 답하지만,
// 개인을 특정할 수 있는 값은 하나도 밖으로 내보내지 않는다.
//
//   xazz policy examples/security/patient_safe.xzz   # 통과 (exit 0)
//   xazz run    examples/security/patient_safe.xzz   # 실행
//
// 데이터는 합성 데이터다:
//   python3 examples/security/generate_patients.py

type Patient = {
    patient_id: string,
    name: string,
    phone: string,
    age: int,
    gender: string,
    zip_code: string,
    disease: string,
    age_band: string,
    visit_count: int,
};

// ── 안전 1: 연령대별 환자 수 ────────────────────────────────────────────────
// patient_id 는 집계 대상이므로 결과 컬럼은 '건수'다 — 식별자가 아니다.
v by_age_band = load("examples/security/data/patients.csv") :: Patient
    |> groupBy("age_band")
    |> count("patient_id")
    |> orderBy("patient_id", desc: true);

// ── 안전 2: 질병별 환자 수 + 차등 프라이버시 ────────────────────────────────
// 민감 속성(disease)을 그룹 키로 쓰는 집계이므로 withDp 가 필수다.
v by_disease = load("examples/security/data/patients.csv") :: Patient
    |> groupBy("disease")
    |> count("patient_id")
    |> withDp(epsilon: 1.0, mechanism: laplace, sensitivity: 1.0, seed: 42)
    |> orderBy("patient_id", desc: true)
    |> take(10);

// ── 안전 3: 연령대별 평균 방문 횟수 ─────────────────────────────────────────
v visits_by_band = load("examples/security/data/patients.csv") :: Patient
    |> groupBy("age_band")
    |> mean("visit_count");
