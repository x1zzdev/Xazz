// Xazz 데모 2 — Burn 딥러닝 학습 컴파일
type Air = {
    observed_at:   string,
    district:      string,
    pm25:          Option<float>,
    temperature_c: float,
}
v raw = load("visual-ide/data/seoul_air_quality.csv") :: Air
v dataset = raw
    |> cast("pm25", "float")
    |> cast("temperature_c", "float")
    |> fillNull("pm25", strategy: "mean")
    |> select([temperature_c, pm25])
model AirPredictor {
    Dense(16) -> ReLU() -> Dense(1)
}
run dataset
    |> train(AirPredictor, target: "pm25", epochs: 5, lr: 0.01)
