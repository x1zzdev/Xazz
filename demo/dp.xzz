// Xazz 데모 3 — 차등 프라이버시(DP) 노이즈 주입
type Air = {
    observed_at:   string,
    district:      string,
    pm25:          Option<float>,
    temperature_c: float,
}
v x = load("visual-ide/data/seoul_air_quality.csv") :: Air
v means = x
    |> groupBy("district")
    |> mean("pm25")
    |> withDp(epsilon: 1.0, mechanism: laplace, seed: 42)
